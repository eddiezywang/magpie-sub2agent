[Unit]
Description=Authenticated Tencent Cloud staging for Sub2Agent releases
After=network.target

[Service]
ExecStart=/usr/bin/python3 /opt/sub2agent-release-stage/private-stage.py --root /srv/sub2agent-release-stage --authorization /etc/sub2agent-release-stage/authorization --cert /etc/sub2agent-release-stage/cloud.crt --key /etc/sub2agent-release-stage/cloud.key
User=sub2agent-stage
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
Restart=on-failure

[Install]
WantedBy=multi-user.target
